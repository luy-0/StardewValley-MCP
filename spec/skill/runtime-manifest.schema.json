{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardew-valley-mcp.dev/spec/skill/runtime-manifest.schema.json",
  "title": "Stardew Valley MCP 可执行 Skill Runtime Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entrypoint", "tool", "requires", "execution"],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*\\.py:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "description", "inputSchema", "outputSchema", "annotations"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^stardew_skill_[a-z0-9]+(?:_[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "inputSchema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*\\.json$"
        },
        "outputSchema": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*\\.json$"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
          "properties": {
            "readOnlyHint": { "type": "boolean" },
            "destructiveHint": { "type": "boolean" },
            "idempotentHint": { "type": "boolean" },
            "openWorldHint": { "type": "boolean" }
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^stardew_[a-z0-9]+(?:_[a-z0-9]+)*$"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "concurrency"],
      "properties": {
        "timeoutSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "concurrency": {
          "const": "exclusive"
        }
      }
    }
  }
}
