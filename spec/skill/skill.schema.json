{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stardewvalley-mcp.dev/spec/skill/v1/skill.schema.json",
  "title": "StardewValley MCP Skill package manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "version", "description", "game", "entrypoint",
    "input_schema", "output_schema", "requires", "risk",
    "timeout_seconds", "cancellable", "retry", "failure_codes"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,}$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "game": {"const": "stardew-valley"},
    "entrypoint": {"const": "implementation:run"},
    "input_schema": {"$ref": "#/$defs/closedObjectSchema"},
    "output_schema": {
      "oneOf": [
        {"$ref": "#/$defs/closedObjectSchema"},
        {"$ref": "#/$defs/openOutputSchema"}
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "version": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "risk": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["changes_save", "advances_time", "consumes_item", "consumes_energy", "spends_money", "changes_relationship", "external_communication", "changes_position"]
      }
    },
    "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300},
    "cancellable": {"type": "boolean"},
    "retry": {"const": "never"},
    "failure_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
    }
  },
  "$defs": {
    "schemaNode": {
      "oneOf": [
        {"$ref": "#/$defs/closedObjectSchema"},
        {"$ref": "#/$defs/arraySchema"},
        {"$ref": "#/$defs/stringSchema"},
        {"$ref": "#/$defs/integerSchema"},
        {"$ref": "#/$defs/numberSchema"},
        {"$ref": "#/$defs/booleanSchema"}
      ]
    },
    "closedObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties"],
      "properties": {
        "type": {"const": "object"},
        "description": {"type": "string"},
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/schemaNode"}
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "enum": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "additionalProperties": {"const": false}
      }
    },
    "openOutputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "additionalProperties", "x-open-output"],
      "properties": {
        "type": {"const": "object"},
        "description": {"type": "string"},
        "properties": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/schemaNode"}
        },
        "required": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "enum": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "additionalProperties": {"type": "boolean"},
        "x-open-output": {"const": true}
      }
    },
    "arraySchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "array"},
        "description": {"type": "string"},
        "items": {"$ref": "#/$defs/schemaNode"},
        "enum": {"type": "array", "minItems": 1},
        "minItems": {"type": "integer", "minimum": 0},
        "maxItems": {"type": "integer", "minimum": 0}
      }
    },
    "stringSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "string"},
        "description": {"type": "string"},
        "enum": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "minLength": {"type": "integer", "minimum": 0},
        "maxLength": {"type": "integer", "minimum": 0},
        "pattern": {"type": "string"}
      }
    },
    "integerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "integer"},
        "description": {"type": "string"},
        "enum": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "numberSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "number"},
        "description": {"type": "string"},
        "enum": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"}
      }
    },
    "booleanSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"const": "boolean"},
        "description": {"type": "string"},
        "enum": {"type": "array", "minItems": 1, "items": {"type": "boolean"}}
      }
    }
  }
}
