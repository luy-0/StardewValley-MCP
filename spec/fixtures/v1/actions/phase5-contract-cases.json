      "expected": {"state": "failed", "errorCode": "invalid_arguments"}
    },
    {
      "id": "cancel_after_commit",
      "capabilities": ["interact", "use_tool"],
      "condition": "交互已被游戏消费，或工具 BeginUsingTool 已排队",
      "expected": {
        "accepted": false,
